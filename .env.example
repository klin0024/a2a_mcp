# 這些變數由 settings.py 的 Settings class 讀取（見 settings.py）

# google-adk 需要 Gemini API 金鑰才能實際呼叫模型
GOOGLE_API_KEY=

# 選填：logging 等級（DEBUG/INFO/WARNING/ERROR），不設定預設 INFO
# LOG_LEVEL=INFO

# 選填：只註冊指定的 ADK agent（逗號分隔，對應 agents/adk/{name}/），不設定則自動註冊 agents/adk/ 底下全部
# ADK_AGENT_NAMES=debate_pro

# 選填：只註冊指定的 A2A agent（逗號分隔，對應 agents/a2a/{name}/agent_card.json），不設定則自動註冊 agents/a2a/ 底下全部
# A2A_AGENT_NAMES=debate_con_a2a

# 選填：只註冊指定的 LangChain agent（逗號分隔，對應 agents/langchain/{name}/），不設定則自動註冊 agents/langchain/ 底下全部
# LANGCHAIN_AGENT_NAMES=debate_neutral

# 以下由 fastmcp 套件自己讀取（env_prefix="FASTMCP_"），不經過 settings.py 的 Settings class；
# 注意 FASTMCP_LOG_LEVEL（fastmcp/uvicorn 自己的 log）跟上面的 LOG_LEVEL（我們自己 logger.warning
# 那些訊息）是兩個獨立的設定，不要搞混。

# 選填：MCP transport，不設定預設 stdio；要用 HTTP 服務就設成 http（或 streamable-http）
# FASTMCP_TRANSPORT=http

# 選填：HTTP transport 監聽位址，預設 127.0.0.1（僅本機）；要讓其他機器連得到才需要改 0.0.0.0
# FASTMCP_HOST=127.0.0.1

# 選填：HTTP transport 監聽 port，預設 8000（注意跟本機 adk api_server 常用的 3000 錯開）
# FASTMCP_PORT=8000

# HTTP transport 預設用無狀態模式（每個請求都是獨立的，不需要先 initialize / 帶 Mcp-Session-Id）
FASTMCP_STATELESS_HTTP=true
